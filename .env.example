# ── Optional API keys — add any you have to improve global accuracy ──────

# UK company verification (free — register at developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# Australia company verification (free GUID — register at abr.business.gov.au)
ABN_LOOKUP_GUID=

# Global company search — 200+ jurisdictions (100 free/month — opencorporates.com)
OPENCORPORATES_API_KEY=

# URL threat intelligence — improves URL scoring significantly (free — virustotal.com)
VIRUSTOTAL_API_KEY=

# URL threat intelligence — Google's phishing database (free — console.cloud.google.com)
GOOGLE_SAFE_BROWSING_API_KEY=

# IP geolocation — improves country detection (free — maxmind.com)
MAXMIND_LICENCE_KEY=

# Kaggle dataset download — required to download EMSCAD (free — kaggle.com/settings)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Application
APP_NAME=TrustHire
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string-in-production
DATABASE_URL=postgresql://trusthire_user:trusthire_pass@localhost/trusthire
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Docker Compose PostgreSQL bootstrap (development-only credentials)
POSTGRES_DB=trusthire
POSTGRES_USER=trusthire_user
POSTGRES_PASSWORD=trusthire_pass

# Leave empty in Docker to use nginx's /api/ proxy to the backend service.
VITE_API_BASE_URL=

# Additional external API keys configured by backend/config.py
WHOISXML_API_KEY=

# LLM provider (OpenAI is opt-in; leave its key blank unless selected)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=

# Model artifact locations
BERT_MODEL_PATH=models/bert_fraud_classifier/final
FAISS_INDEX_PATH=models/faiss_index/fake_jobs.index
FAISS_METADATA_PATH=models/faiss_index/metadata.json
BASELINE_MODEL_PATH=models/baseline
URL_CLASSIFIER_PATH=models/url_classifier

# Request limits
RATE_LIMIT_FREE=10/minute
RATE_LIMIT_REGISTERED=60/minute

# Deterministic trust-score configuration
WEIGHT_URL_ANALYSIS=0.35
WEIGHT_NLP_CLASSIFICATION=0.30
WEIGHT_COMPANY_VERIFICATION=0.25
WEIGHT_DUPLICATE_DETECTION=0.05
WEIGHT_SCAM_PHRASES=0.05
VERDICT_THRESHOLDS={"safe": 70, "suspicious": 45, "likely_fraud": 25}

# Optional error monitoring
SENTRY_DSN=
